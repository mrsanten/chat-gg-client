# Skopiuj do `.env` i dostosuj. Plik `.env` jest w .gitignore.

# Adres na którym serwer nasłuchuje (host:port).
BIND_ADDR=0.0.0.0:8080

# Connection string do Postgresa.
DATABASE_URL=postgres://gaidu:gaidu@localhost:5433/gaidu

# Sekret do podpisywania JWT. PRZED PRODUKCJĄ wygeneruj nowy, np.
# `openssl rand -hex 64`. Co najmniej 32 bajty losowości.
JWT_SECRET=development-only-secret-change-me-before-production

# Czas życia tokenów (sekundy). Domyślnie 30 dni dla refresh-friendly UX.
JWT_TTL_SECONDS=2592000

# Poziom logów: trace | debug | info | warn | error.
RUST_LOG=info,gaidu_server=debug,sqlx=warn,tower_http=info
